{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Radial bar chart (24-hour clock), small multiples by season. Each wedge is one hour of the day in local time; its length shows the share of that season's FrogID recordings made in that hour (square-root scale so wedge area matches the value). Midnight is at the top, noon at the bottom. The busiest hour is shaded dark.",
  "data": {
    "url": "data/hour_season.csv",
    "format": {
      "parse": {
        "hour": "number",
        "recordings": "number",
        "share": "number"
      }
    }
  },
  "transform": [
    {
      "calculate": "datum.hour * PI / 12",
      "as": "t0"
    },
    {
      "calculate": "(datum.hour + 1) * PI / 12",
      "as": "t1"
    },
    {
      "calculate": "(datum.hour + 0.5) * PI / 12",
      "as": "tm"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "share",
          "as": "maxShare"
        }
      ],
      "groupby": [
        "season"
      ]
    },
    {
      "calculate": "datum.share == datum.maxShare",
      "as": "isPeak"
    },
    {
      "calculate": "datum.hour == 0 ? 'midnight' : datum.hour == 6 ? '6 am' : datum.hour == 12 ? 'noon' : datum.hour == 18 ? '6 pm' : ''",
      "as": "hourLabel"
    },
    {
      "calculate": "datum.hour == 0 ? '12 am' : datum.hour < 12 ? datum.hour + ' am' : datum.hour == 12 ? '12 pm' : (datum.hour - 12) + ' pm'",
      "as": "clock"
    },
    {
      "calculate": "{'Summer': 'Summer (Dec–Feb)', 'Autumn': 'Autumn (Mar–May)', 'Winter': 'Winter (Jun–Aug)', 'Spring': 'Spring (Sep–Nov)'}[datum.season]",
      "as": "seasonLabel"
    },
    {
      "calculate": "{'Summer': 1, 'Autumn': 2, 'Winter': 3, 'Spring': 4}[datum.season]",
      "as": "seasonOrder"
    }
  ],
  "facet": {
    "column": {
      "field": "seasonLabel",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "seasonOrder"
      },
      "header": {
        "labelFontSize": 13,
        "labelFontWeight": 600,
        "labelColor": "#1b2b26",
        "labelPadding": 2
      }
    }
  },
  "spacing": 70,
  "spec": {
    "width": 190,
    "height": 190,
    "layer": [
      {
        "mark": {
          "type": "arc",
          "innerRadius": 16,
          "stroke": "#f3f5f0",
          "strokeWidth": 0.8,
          "padAngle": 0.004
        },
        "encoding": {
          "theta": {
            "field": "t0",
            "type": "quantitative",
            "scale": null
          },
          "radius": {
            "field": "share",
            "type": "quantitative",
            "scale": {
              "type": "sqrt",
              "zero": true,
              "domain": [
                0,
                21
              ],
              "range": [
                16,
                88
              ]
            }
          },
          "color": {
            "condition": {
              "test": "datum.isPeak",
              "value": "#9a4d0a"
            },
            "value": "#f0a95a"
          },
          "tooltip": [
            {
              "field": "seasonLabel",
              "title": "Season"
            },
            {
              "field": "clock",
              "title": "Hour starting"
            },
            {
              "field": "recordings",
              "title": "Recordings",
              "format": ","
            },
            {
              "field": "share",
              "title": "Share of the season's recordings (%)",
              "format": ".1f"
            }
          ],
          "theta2": {
            "field": "t1"
          }
        }
      },
      {
        "mark": {
          "type": "text",
          "fontSize": 10.5,
          "color": "#5b6b65",
          "align": "center",
          "baseline": "middle"
        },
        "encoding": {
          "theta": {
            "field": "t0",
            "type": "quantitative",
            "scale": null
          },
          "radius": {
            "value": 102
          },
          "text": {
            "field": "hourLabel"
          }
        },
        "transform": [
          {
            "filter": "datum.hourLabel != ''"
          }
        ]
      },
      {
        "transform": [
          {
            "filter": "datum.isPeak"
          }
        ],
        "mark": {
          "type": "text",
          "fontSize": 12,
          "fontWeight": 700,
          "color": "#9a4d0a",
          "baseline": "middle"
        },
        "encoding": {
          "x": {
            "value": 95
          },
          "y": {
            "value": 222
          },
          "text": {
            "field": "clock",
            "type": "nominal"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.isPeak"
          }
        ],
        "mark": {
          "type": "text",
          "fontSize": 11,
          "color": "#5b6b65",
          "baseline": "middle",
          "fontStyle": "italic"
        },
        "encoding": {
          "x": {
            "value": 95
          },
          "y": {
            "value": 238
          },
          "text": {
            "value": "busiest hour"
          }
        }
      }
    ]
  }
}