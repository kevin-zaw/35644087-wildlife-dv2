{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle (unit) chart. Each square is 1% of the 154.4 million records of animals, plants and fungi available for Australia through GBIF (January 2026), coloured by the dataset that supplied it. The four largest single datasets are shown separately. Hover a colour to highlight that source.",
  "data": {
    "url": "data/national_sources_units.csv",
    "format": {
      "parse": {
        "unit": "number",
        "col": "number",
        "row": "number",
        "records": "number",
        "pct": "number",
        "order": "number"
      }
    }
  },
  "hconcat": [
    {
      "width": 300,
      "height": 300,
      "params": [
        {
          "name": "srcHover",
          "select": {
            "type": "point",
            "fields": [
              "source"
            ],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "square",
        "size": 620,
        "cornerRadius": 2,
        "cursor": "pointer"
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "ordinal",
          "axis": null
        },
        "y": {
          "field": "row",
          "type": "ordinal",
          "axis": null
        },
        "color": {
          "field": "source",
          "type": "nominal",
          "title": "Where the records come from",
          "sort": [
            "Volunteer birdwatching apps (eBird, Birdata)",
            "State government atlases (NSW, Victoria)",
            "All other sources (museums, herbaria, surveys, apps)"
          ],
          "scale": {
            "domain": [
              "Volunteer birdwatching apps (eBird, Birdata)",
              "State government atlases (NSW, Victoria)",
              "All other sources (museums, herbaria, surveys, apps)"
            ],
            "range": [
              "#b8610f",
              "#3f5866",
              "#dde3df"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "vertical",
            "symbolType": "square",
            "symbolSize": 170,
            "labelLimit": 360,
            "labelFontSize": 12.5,
            "titleFontSize": 13,
            "symbolStrokeColor": "#8c9a96",
            "symbolStrokeWidth": 0.6
          }
        },
        "opacity": {
          "condition": {
            "param": "srcHover",
            "value": 1
          },
          "value": 0.3
        },
        "tooltip": [
          {
            "field": "source",
            "title": "Source type"
          },
          {
            "field": "records",
            "title": "Records about Australia",
            "format": ","
          },
          {
            "field": "pct",
            "title": "Share of all records (%)"
          }
        ]
      }
    },
    {
      "width": 260,
      "height": 300,
      "data": {
        "values": [
          {
            "y": 0,
            "t": [
              "44 of every 100 records come",
              "from two volunteer birdwatching",
              "apps: eBird (36.5) and Birdata (7.5)."
            ],
            "c": "#8a4a0b"
          },
          {
            "y": 78,
            "t": [
              "Together they hold 68 million",
              "records, 73% of all bird records."
            ],
            "c": "#8a4a0b"
          },
          {
            "y": 142,
            "t": [
              "State government atlases add",
              "another 16 (NSW 9.5, Victoria 6.5)."
            ],
            "c": "#3f5866"
          },
          {
            "y": 222,
            "t": [
              "The remaining 40% comes from",
              "hundreds of museums, herbaria,",
              "surveys and apps."
            ],
            "c": "#33443e"
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "fontSize": 13,
        "lineHeight": 17,
        "fontStyle": "italic"
      },
      "encoding": {
        "x": {
          "value": 0
        },
        "y": {
          "field": "y",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              300
            ],
            "range": [
              0,
              300
            ]
          },
          "axis": null
        },
        "text": {
          "field": "t"
        },
        "color": {
          "field": "c",
          "type": "nominal",
          "scale": null
        }
      }
    }
  ],
  "spacing": 40
}