            "t": "No frog records (grey)",
            "y": 492
          }
        ]
      },
      "layer": [
        {
          "transform": [
            {
              "filter": "datum.k=='sq'"
            }
          ],
          "mark": {
            "type": "square",
            "size": 150,
            "color": "#d3ebe6",
            "stroke": "#9fcfc5",
            "opacity": 1
          },
          "encoding": {
            "x": {
              "value": 8
            },
            "y": {
              "field": "y",
              "type": "quantitative",
              "scale": null
            }
          }
        },
        {
          "transform": [
            {
              "filter": "datum.k=='dot'"
            }
          ],
