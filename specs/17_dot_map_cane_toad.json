{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dot map. Each charcoal dot is a 5 km square where FrogID volunteers recorded the introduced cane toad in 2023 (all dots the same size). Pale teal squares show the 1-degree squares where anyone recorded any frog, so blank areas mean no listeners rather than no toads.",
  "width": 640,
  "height": 520,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -18,
      -36
    ],
    "rotate": [
      -132,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/au_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#eceeea",
        "stroke": "#ffffff",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/grid_1deg.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#d3ebe6",
        "stroke": "#eceeea",
        "strokeWidth": 0.4
      }
    },
    {
      "data": {
        "url": "data/au_states.topojson",
        "format": {
          "type": "topojson",
          "feature": "states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      }
    },
    {
      "data": {
        "url": "data/canetoad_points.csv",
        "format": {
          "parse": {
            "lon": "number",
            "lat": "number",
            "n": "number"
          }
        }
      },
      "params": [
        {
          "name": "toadHover",
          "select": {
            "type": "point",
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "stroke": "#ffffff",
        "strokeWidth": 0.6,
        "cursor": "pointer",
        "size": 26
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "value": "#2a2a2a"
        },
        "opacity": {
          "condition": {
            "param": "toadHover",
            "empty": false,
            "value": 1
          },
          "value": 0.8
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State or territory"
          },
          {
            "field": "n",
            "title": "Cane toad records in this 5 km square"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {
            "city": "Sydney",
            "lon": 151.21,
            "lat": -33.87
          },
          {
            "city": "Melbourne",
            "lon": 144.96,
